# Local runs only. On the box, the deploy workflow writes .env from the oracle-cloud
# environment's secrets and variables (see README).

# Telegram: bot token from @BotFather; your user id (send /id to the bot).
TELEGRAM_BOT_TOKEN=
TELEGRAM_USER_ID=

# The shop's website, and the saved address to deliver to: its label, and text that must appear in it
# (e.g. a flat number).
SHOP_URL=
ADDRESS_LABEL=
ADDRESS_MATCH=

# Safety limits (₹). Orders below MIN_ORDER_INR get a delivery fee, so they are not placed.
DAILY_CAP_INR=1000
MIN_ORDER_INR=100

# false = fill and verify the cart only.
PLACE_ORDERS=false

# Home exit: the shop refuses data-centre IPs. Tailscale IP of the home exit node, and an auth key
# (needed only for the first login; the identity is kept on the data volume).
TS_EXIT_NODE=
TS_AUTHKEY=

# Optional
# WHISPER_MODEL=small
# HEALTH_CHECK_HOUR=9
