# Local runs only. On the box, the deploy workflow writes .env from the oracle-cloud
# environment's secrets and variables (see README).

# Telegram: bot token from @BotFather, and the admin's user id (send /id to the bot): the admin lets
# new people in and gets the bot's own alerts. Everything about each shop account (address, limits,
# placing orders on/off, who orders with it) is set in Telegram: /setup, /settings, /members.
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_ID=

SHOP_URL=

# Home exit: the shop refuses data-centre IPs. Tailscale IP of the home exit node, and an auth key
# (needed only for the first login; the identity is kept on the data volume).
TS_EXIT_NODE=
TS_AUTHKEY=

# Optional
# WHISPER_MODEL=small
# HEALTH_CHECK_HOUR=9
# LOG_LEVEL=INFO
