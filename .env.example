# Local runs only; the deploy workflow writes the box's .env (README).
TELEGRAM_BOT_TOKEN=
# Comma-separated; the first gets alerts.
TELEGRAM_USER_IDS=

SHOP_URL=
# Saved address name, and text it must contain (e.g. flat number).
ADDRESS_LABEL=
ADDRESS_MATCH=

DAILY_CAP_INR=1000
# Below this the shop charges delivery; lists wait in the basket.
MIN_ORDER_INR=100
# false: fill and check the cart only.
PLACE_ORDERS=false

# Home exit node's Tailscale IP; auth key for the first login only.
TS_EXIT_NODE=
TS_AUTHKEY=

# WHISPER_MODEL=small
# HEALTH_CHECK_HOUR=9
# LOG_LEVEL=INFO
